# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/database

# Security Keys (CHANGE IN PRODUCTION!)
# WARNING: L3_HMAC_SECRET is REQUIRED in production - no fallback default
SECRET_KEY=aaa-engine-secret-key-change-in-production
L3_HMAC_SECRET=your-hmac-secret-for-challenge-tokens-change-me

# Environment
DEBUG=true

# Optional: CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Verification Thresholds (0.0 - 1.0)
# L2_SPOOF_THRESHOLD: Reject if spoof confidence > this
# L1_SIMILARITY_THRESHOLD: Reject if speaker similarity < this
# ASR_PHRASE_THRESHOLD: Reject if phrase similarity < this
L2_SPOOF_THRESHOLD=0.5
L1_SIMILARITY_THRESHOLD=0.5
ASR_PHRASE_THRESHOLD=0.6

# Challenge Configuration
CHALLENGE_TTL_SECONDS=90

# Model Configuration
WHISPER_MODEL=base

# Optional: Model Cache Directory
# MODEL_CACHE_DIR=./pretrained_models

# ============================================================================
# AAA Engine Environment Variables
# Adaptive Audio Authentication with Deepfake Detection
# ============================================================================
# INSTRUCTIONS:
#   1. Copy this file to .env: cp .env.example .env
#   2. Fill in all required values (marked with [REQUIRED])
#   3. NEVER commit .env to version control
# ============================================================================

# =============================================================================
# DATABASE CONFIGURATION [REQUIRED]
# =============================================================================
# PostgreSQL (Production - Supabase/Neon/Railway)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# SQLite (Development only - NOT for production)
# DATABASE_URL=sqlite:///./aaa_engine.db

# =============================================================================
# JWT AUTHENTICATION [REQUIRED]
# =============================================================================
# Minimum 32 characters, cryptographically secure
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AAA_JWT_SECRET=your_32_plus_character_cryptographically_secure_jwt_secret_here

# JWT Token Settings
AAA_JWT_ALGORITHM=HS256
AAA_JWT_ISSUER=aaa-engine
AAA_JWT_AUDIENCE=aaa-clients
AAA_JWT_EXPIRY_HOURS=24

# =============================================================================
# CHALLENGE TOKEN SECURITY [REQUIRED for production]
# =============================================================================
# HMAC secret for challenge token signing
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
L3_HMAC_SECRET=your_hmac_secret_minimum_32_characters_long

# Challenge configuration
CHALLENGE_TTL_SECONDS=90

# =============================================================================
# VOICEPRINT ENCRYPTION [REQUIRED for production]
# =============================================================================
# AES-256-GCM encryption key for voiceprint storage
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
VOICEPRINT_ENCRYPTION_KEY=your_aes256_encryption_key_here

# =============================================================================
# CORS CONFIGURATION [REQUIRED]
# =============================================================================
# Comma-separated list of allowed origins (NO wildcards '*' allowed)
# Include all frontend URLs that will access the API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174,https://your-frontend.com

# =============================================================================
# MODEL THRESHOLDS (Optional - defaults provided)
# =============================================================================
# Layer 2 - Deepfake Detection
# Higher = stricter (more false positives, fewer false negatives)
L2_SPOOF_THRESHOLD=0.5

# Layer 1 - Speaker Verification
# Higher = stricter (requires closer voice match)
L1_SIMILARITY_THRESHOLD=0.5

# ASR - Phrase Matching
# Higher = stricter (requires more exact phrase match)
ASR_PHRASE_THRESHOLD=0.6

# =============================================================================
# MODEL CONFIGURATION (Optional)
# =============================================================================
# Whisper model size: tiny, base, small, medium, large
# Larger = more accurate but slower and more memory
WHISPER_MODEL=base

# =============================================================================
# RATE LIMITING (Optional - defaults provided)
# =============================================================================
# Format: "requests/period" (e.g., "10/minute", "100/hour")
RATE_LIMIT_CHALLENGES=10/minute
RATE_LIMIT_VERIFY=5/minute
RATE_LIMIT_ENROLL=3/5minutes

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Debug mode (set to false in production!)
DEBUG=false

# Application info
APP_NAME=AAA Engine
APP_VERSION=1.0.0

# =============================================================================
# TENANT CONFIGURATION (Multi-tenant deployments)
# =============================================================================
# Default tenant ID for single-tenant deployments
DEFAULT_TENANT_ID=default

# Enable tenant isolation (RLS)
ENABLE_TENANT_ISOLATION=true

# =============================================================================
# LOGGING & MONITORING (Optional)
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable structured JSON logging
LOG_FORMAT=json

# Enable PII redaction in logs
LOG_REDACT_PII=true

# =============================================================================
# HOST APPLICATION REGISTRATION (Optional)
# =============================================================================
# Pre-registered host applications (JSON format)
# Format: {"app_id": {"name": "App Name", "secret_hash": "sha256_hash", "allowed_origins": ["..."]}}
# REGISTERED_HOST_APPS={}

# =============================================================================
# NOTES
# =============================================================================
# Security Best Practices:
#   - Use strong, unique secrets (64+ hex characters recommended)
#   - Rotate secrets periodically
#   - Never use DEBUG=true in production
#   - Always use PostgreSQL in production (not SQLite)
#   - Set explicit CORS origins (no wildcards)
#
# Generating Secrets:
#   python -c "import secrets; print(secrets.token_hex(32))"
#   openssl rand -hex 32
#
# Database URLs:
#   Supabase: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
#   Neon: postgresql://[user]:[password]@[host].neon.tech/[db]?sslmode=require
#   Railway: postgresql://postgres:[password]@[host].railway.app:5432/railway
# =============================================================================

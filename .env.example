# AAA Engine Environment Variables
# Copy to .env and fill in real values (never commit .env!)

# Postgres connection string (Neon/Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT/Token secret for challenge tokens
SECRET_KEY=your-secret-key-here

# AAA Middleware JWT Secret for Tenant Authentication (MUST be cryptographically strong, min 32 chars)
AAA_JWT_SECRET=your_32_plus_character_cryptographically_secure_jwt_secret_here

# Strict CORS Whitelist (comma-separated origins; wildcards '*' strictly prohibited)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: Debug mode
DEBUG=false
